
---
import BaseLayout from "../layouts/BaseLayout.astro";

const file = Astro.url.searchParams.get("file");
---

<BaseLayout
  title="Unlock Your Journal | First7"
  description="Access your First7 guided Scripture journal."
>
  <div class="max-w-md mx-auto px-4 py-20 text-center">
    <h1 class="text-2xl font-semibold">
      Unlock Your Journal
    </h1>

    <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">
      Enter your email to access this 7-day guide.
    </p>

    <!-- Replace with Beehiiv embed -->
    <form action="#" method="POST" class="mt-6 space-y-4">
      <input
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder="Your email"
        aria-label="Your email address"
        class="w-full px-4 py-3 border rounded-xl"
      />

      <button type="submit" class="btn w-full px-4 py-3 rounded-xl">
        Unlock →
      </button>
    </form>

    {file && (
      <div class="mt-8">
        <a
          href={file}
          download
          class="btn inline-block px-5 py-3 rounded-xl"
        >
          Download Now →
        </a>
      </div>
    )}
  </div>
</BaseLayout>