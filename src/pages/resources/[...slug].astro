---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import ResourceLayout from "../../components/resources/ResourceLayout.astro";

import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("resources");

  // Generic resource pages only.
  // Journals and other category-specific resources
  // are handled by their own routes.
  const genericEntries = entries.filter((entry) => {
    const reservedRoutes = [
      "journals/",
      "studies/",
      "verse-cards/",
    ];

    return !reservedRoutes.some((prefix) =>
      entry.id.startsWith(prefix)
    );
  });

  return genericEntries.map((entry) => ({
    params: {
      slug: entry.id,
    },
    props: {
      entry,
    },
  }));
}

const { entry } = Astro.props;

const { Content } = await render(entry);

const resources = await getCollection("resources");
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
>
  <ResourceLayout
    entry={entry}
    resources={resources}
  >
    <Content />
  </ResourceLayout>
</BaseLayout>