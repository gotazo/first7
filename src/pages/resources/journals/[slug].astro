---
export const prerender = true;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import ResourceLayout from "../../../components/resources/ResourceLayout.astro";

import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const resources = await getCollection("resources");

  const journals = resources
    .filter((entry) => entry.id.startsWith("journals/"))
    .sort(
      (a, b) => (a.data.month ?? 99) - (b.data.month ?? 99)
    );

  return journals.map((entry) => ({
    params: {
      slug: entry.id.replace(/^journals\//, ""),
    },
    props: {
      entry,
    },
  }));
}

const resources = await getCollection("resources");

const journals = resources
  .filter((journal) => journal.id.startsWith("journals/"))
  .sort(
    (a, b) => (a.data.month ?? 99) - (b.data.month ?? 99)
  );

const { entry } = Astro.props;

const { Content } = await render(entry);

/*
 * Previous / next journal navigation.
 */
const currentIndex = journals.findIndex(
  (journal) => journal.id === entry.id
);

const previousJournal =
  currentIndex > 0
    ? journals[currentIndex - 1]
    : null;

const nextJournal =
  currentIndex < journals.length - 1
    ? journals[currentIndex + 1]
    : null;

const getSlug = (journal: (typeof journals)[number]) =>
  journal.id.replace(/^journals\//, "");
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
>

  <main>

    <!-- BREADCRUMB -->
    <div class="max-w-6xl mx-auto px-4 pt-8">

      <nav
        aria-label="Breadcrumb"
        class="text-sm text-[var(--color-muted)]"
      >

        <a
          href="/resources"
          class="hover:text-[var(--color-primary)] transition"
        >
          Resources
        </a>

        <span class="mx-2">/</span>

        <a
          href="/resources/journals"
          class="hover:text-[var(--color-primary)] transition"
        >
          Scripture Journals
        </a>

        <span class="mx-2">/</span>

        <span class="text-[var(--color-text)]">
          {entry.data.title}
        </span>

      </nav>

    </div>


    <!-- JOURNAL CONTENT -->
    <ResourceLayout
      entry={entry}
      resources={resources}
    >
      <Content />
    </ResourceLayout>


    <!-- AVAILABLE FORMATS -->
    {(entry.data.pdf_url ||
      entry.data.file ||
      entry.data.paperback_url) && (

      <section class="max-w-5xl mx-auto px-4 pb-16">

        <div
          class="rounded-3xl border border-[var(--color-border)] bg-[var(--color-primary)]/5 p-8 md:p-10"
        >

          <div class="max-w-2xl">

            <p
              class="text-sm uppercase tracking-[0.16em] text-[var(--color-primary)] font-medium"
            >
              Available Formats
            </p>

            <h2 class="mt-3 text-2xl md:text-3xl font-semibold">
              Choose the format that works for you
            </h2>

            <p class="mt-4 leading-7 text-[var(--color-muted)]">
              Get the free digital edition, or explore printable and
              professionally printed options when available.
            </p>

          </div>


          <div class="mt-8 grid gap-5 md:grid-cols-2">

            <!-- DIGITAL EDITION -->
            {(entry.data.pdf_url || entry.data.file) && (

              <div
                class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6"
              >

                <p
                  class="text-xs uppercase tracking-[0.14em] text-[var(--color-primary)] font-medium"
                >
                  Digital Edition
                </p>

                <h3 class="mt-2 text-xl font-semibold">
                  Free Scripture Journal PDF
                </h3>

                <p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">
                  Get the free digital edition of this journal and begin your
                  journey one day at a time.
                </p>

                {entry.data.pdf_url ? (
                  <a
                    href={entry.data.pdf_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn mt-6 inline-block"
                  >
                    {entry.data.pdf_label || "Get Free PDF"} →
                  </a>
                ) : entry.data.file ? (
                  <a
                    href={entry.data.file}
                    download
                    class="btn mt-6 inline-block"
                  >
                    Download PDF →
                  </a>
                ) : null}

              </div>

            )}


            <!-- PRINTED BOOK -->
            {entry.data.paperback_url && (

              <div
                class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6"
              >

                <p
                  class="text-xs uppercase tracking-[0.14em] text-[var(--color-primary)] font-medium"
                >
                  Printed Edition
                </p>

                <h3 class="mt-2 text-xl font-semibold">
                  Professionally Printed Book
                </h3>

                <p class="mt-3 text-sm leading-6 text-[var(--color-muted)]">
                  Prefer a physical copy? Explore the professionally printed
                  edition of this journal.
                </p>

                {entry.data.paperback_price && (
                  <p class="mt-4 text-sm font-medium">
                    {entry.data.paperback_price}
                  </p>
                )}

                <a
                  href={entry.data.paperback_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-secondary mt-6 inline-block"
                >
                  {entry.data.paperback_label || "View Printed Edition"} →
                </a>

              </div>

            )}

          </div>

        </div>

      </section>

    )}


    <!-- PREVIOUS / NEXT -->
    <section class="max-w-5xl mx-auto px-4 pb-20">

      <div class="border-t border-[var(--color-border)] pt-8">

        <div class="flex items-center justify-between gap-6">

          <!-- PREVIOUS -->
          {previousJournal ? (

            <a
              href={`/resources/journals/${getSlug(previousJournal)}`}
              class="group max-w-[45%]"
            >

              <p
                class="text-xs uppercase tracking-[0.14em] text-[var(--color-muted)]"
              >
                Previous Journal
              </p>

              <p
                class="mt-2 font-medium group-hover:text-[var(--color-primary)] transition"
              >
                ← {previousJournal.data.title}
              </p>

            </a>

          ) : (

            <a
              href="/resources/journals"
              class="text-sm font-medium text-[var(--color-primary)]"
            >
              ← All Journals
            </a>

          )}


          <!-- NEXT -->
          {nextJournal ? (

            <a
              href={`/resources/journals/${getSlug(nextJournal)}`}
              class="group max-w-[45%] text-right"
            >

              <p
                class="text-xs uppercase tracking-[0.14em] text-[var(--color-muted)]"
              >
                Next Journal
              </p>

              <p
                class="mt-2 font-medium group-hover:text-[var(--color-primary)] transition"
              >
                {nextJournal.data.title} →
              </p>

            </a>

          ) : (

            <a
              href="/resources/journals"
              class="text-sm font-medium text-[var(--color-primary)]"
            >
              All Journals →
            </a>

          )}

        </div>

      </div>

    </section>

  </main>

</BaseLayout>