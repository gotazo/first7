
---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import DictionaryLayout from "../../components/tools/dictionary/DictionaryLayout.astro";

import {
  getCollection,
  render,
} from "astro:content";

import {
  buildStudyMoreIndex,
  getStudyMoreResult,
} from "../../lib/study-more";

export async function getStaticPaths() {
  const entries = await getCollection("dictionary");

  return entries.map((entry) => ({
    params: {
      slug: entry.id,
    },
    props: {
      entry,
    },
  }));
}

const { entry } = Astro.props;

const { Content } = await render(entry);

const [allDictionary, allTeachings, allProphecy, allNumbers] =
  await Promise.all([
    getCollection("dictionary"),
    getCollection("teachings"),
    getCollection("prophecy"),
    getCollection("numbers"),
  ]);

const collections = {
  dictionary: allDictionary,
  teachings: allTeachings,
  prophecy: allProphecy,
  numbers: allNumbers,
};

const relationshipIndex = await buildStudyMoreIndex();

const studyMore = getStudyMoreResult(relationshipIndex, {
  kind: "dictionary",
  id: entry.id,
});

const resolvedRelatedTerms =
  studyMore.groups
    .filter((group) => group.kind === "dictionary")
    .flatMap((group) => group.items);
---

<BaseLayout
  title={`${entry.data.title} Meaning`}
  description={entry.data.shortMeaning}
>
  <DictionaryLayout
    entry={entry}
    collections={collections}
    resolvedRelatedTerms={resolvedRelatedTerms}
  >
    <Content />
  </DictionaryLayout>
</BaseLayout>
