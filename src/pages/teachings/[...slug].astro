---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";

import StudyHero from "../../components/study/common/StudyHero.astro";
import StudyHeroMeta from "../../components/study/common/StudyHeroMeta.astro";
import StudyShare from "../../components/study/common/StudyShare.astro";
import StudyBreadcrumb from "../../components/study/common/StudyBreadcrumb.astro";
import StudyPreviousNext from "../../components/study/common/StudyPreviousNext.astro";

import StudySection from "../../components/study/common/StudySection.astro";
import StudyScripture from "../../components/study/teachings/StudyScripture.astro";

import RelatedScriptures from "../../components/prophecy/RelatedScriptures.astro";
import StudyTerms from "../../components/prophecy/StudyTerms.astro";
import RelatedTopics from "../../components/prophecy/RelatedTopics.astro";

import {
  getCollection,
} from "astro:content";

import {
  teachingTopics,
} from "../../data/teachings/teachingTopics";

import {
  buildStudyMoreIndex,
  getStudyMoreResult,
} from "../../lib/study-more";

export async function getStaticPaths() {

  const teachings =
    await getCollection("teachings");

  const relationshipIndex = await buildStudyMoreIndex();

  const orderedTeachings =
    [...teachings].sort((a, b) => {

      const aOrder =
        a.data.order ?? Number.POSITIVE_INFINITY;

      const bOrder =
        b.data.order ?? Number.POSITIVE_INFINITY;

      if (aOrder !== bOrder) {
        return aOrder - bOrder;
      }

      return a.id.localeCompare(b.id);

    });

  const paths =
    orderedTeachings.map((t, index) => {

      const previous =
        orderedTeachings[index - 1];

      const next =
        orderedTeachings[index + 1];

      const studyMore = getStudyMoreResult(
        relationshipIndex,
        {
          kind: "teachings",
          id: t.id,
        },
      );

      const relatedDictionaryIds = studyMore.groups
        .filter((group) => group.kind === "dictionary")
        .flatMap((group) => group.items.map((item) => item.id));

      const relatedProphecyIds = studyMore.groups
        .filter((group) => group.kind === "prophecy")
        .flatMap((group) => group.items.map((item) => item.id));

      return {

        params: {
          slug: String(t.id),
        },

        props: {

          teaching: t,
          relatedDictionaryIds,
          relatedProphecyIds,

          previous: previous
            ? {
                title: previous.data.title,
                href: `/teachings/${previous.id}`,
              }
            : undefined,

          next: next
            ? {
                title: next.data.title,
                href: `/teachings/${next.id}`,
              }
            : undefined,

        },

      };

    });

  if (
    import.meta.env.BUILD_TRACE
    === "true"
  ) {

    console.log(
      `[build:paths] teachings paths=${paths.length}`
    );

  }

  return paths;

}

const {
  teaching,
  previous,
  next,
  relatedDictionaryIds,
  relatedProphecyIds,
} = Astro.props;

/**
 * 📚 Teaching Topic Labels
 *
 * The teaching Markdown files store canonical
 * topic IDs. The registry provides the
 * human-readable display labels.
 *
 * Example:
 * "holy-spirit" → "Holy Spirit"
 * "spiritual-growth" → "Spiritual Growth"
 */
const teachingTopicLabels =
  Object.fromEntries(
    teachingTopics.map((topic) => [
      topic.id,
      topic.label,
    ])
  );

/**
 * 📚 Collections
 */
const allProphecy =
  await getCollection("prophecy");

const allDictionary =
  await getCollection("dictionary");

/**
 * 🔮 Related prophecy
 *
 * IDs come from the shared Study More resolver.
 * Map them back to Astro entries for the existing
 * RelatedTopics component.
 */
const relatedProphecy = allProphecy.filter(
  (entry) =>
    relatedProphecyIds.includes(entry.id) &&
    !entry.data.draft
);

/**
 * 📘 Related dictionary
 *
 * Map resolver IDs back to full Astro entries so
 * StudyTerms retains its existing data contract.
 */
const teachingKeywords = teaching.data.keywords.map(
  (keyword: string) => keyword.toLowerCase()
);

// Preserve the legacy case-insensitive matches while also
// including any additional Dictionary relationships resolved
// by Study More. Keep the original collection order.
const dictionaryTerms = allDictionary.filter(
  (entry) =>
    teachingKeywords.includes(entry.data.term.toLowerCase()) ||
    relatedDictionaryIds.includes(entry.id)
);
---

<BaseLayout
  title={teaching.data.title}
>

  <!-- Main -->

  <div
    data-reading-title={teaching.data.title}
    data-reading-description={teaching.data.summary}
    data-reading-category={teaching.data.topics?.[0]}
  >

    <article
      class="
        mx-auto
        w-full
        max-w-4xl
        space-y-10
      "
    >

      <!-- Header -->

      <StudyBreadcrumb
        items={[
          { label: "Home", href: "/" },
          { label: "Teachings", href: "/teachings" },
          { label: teaching.data.title },
        ]}
      />

      <StudyHero
        section="Teaching"
        title={teaching.data.title}
        description={teaching.data.summary}
      >

        <StudyHeroMeta
          slot="meta"
          label="Topics"
          items={teaching.data.topics}
          itemLabels={teachingTopicLabels}
          href="/teachings"
          linkLabel="View all topics"
        />

        <StudyShare
          slot="actions"
          title={teaching.data.title}
        />

      </StudyHero>

      <!-- Scripture -->

      <StudyScripture
        reference={teaching.data.scripture.ref}
        text={teaching.data.scripture.text}
      />

      <!-- Truth -->

      <StudySection title="Truth">

        <p>
          {teaching.data.truth}
        </p>

      </StudySection>

      <!-- Insight -->

      <StudySection title="Insight">

        <ul
          class="
            list-disc
            space-y-2
            pl-6
          "
        >

          {teaching.data.insight.map(
            (i: string) => (

              <li>
                {i}
              </li>

            )
          )}

        </ul>

      </StudySection>

      <!-- Application -->

      <StudySection title="Application">

        <ul
          class="
            list-disc
            space-y-2
            pl-6
          "
        >

          {teaching.data.application.map(
            (a: string) => (

              <li>
                {a}
              </li>

            )
          )}

        </ul>

      </StudySection>

      <!-- Prayer -->

      {teaching.data.prayer && (

        <section class="space-y-3">

          <h2
            class="
              text-xl
              font-medium
            "
          >
            Prayer
          </h2>

          <p>
            {teaching.data.prayer}
          </p>

        </section>

      )}

      <!-- Related Scriptures -->

      {teaching.data.scriptures?.length > 0 && (

        <RelatedScriptures
          scriptures={
            teaching.data.scriptures
          }
        />

      )}

      <!-- Related Dictionary -->

      {dictionaryTerms.length > 0 && (

        <StudyTerms
          terms={dictionaryTerms}
        />

      )}

      <!-- Related Prophecy -->

      {relatedProphecy.length > 0 && (

        <RelatedTopics
          topics={relatedProphecy}
        />

      )}

       <!-- Previous / Next -->

      <StudyPreviousNext
        previous={previous}
        next={next}
      />

      <!-- Footer -->

      <section
        class="
          space-y-4
          border-t
          border-[var(--color-border)]
          pt-6
        "
      >

        <p
          class="
            text-sm
            leading-relaxed
            text-[var(--color-muted)]
          "
        >

          These teachings are prayerfully
          developed through Scripture study,
          sermon preparation, biblical research,
          and insights learned from various
          pastors and teachers.

          Content is carefully rewritten and
          organized to encourage spiritual
          growth while remaining grounded
          in Scripture.

        </p>

        <a
          href="/share"
          class="
            btn
            inline-block
            rounded-lg
            px-5
            py-2.5
            text-sm
            font-medium
          "
        >
          Share a reflection or testimony →
        </a>

      </section>

    </article>

  </div>

</BaseLayout>

<script>
  import { saveContinueReading } from "../../lib/reading/continueReading";

  // 📖 Save continuation when browser storage is available. Reading remains usable
  // even when localStorage is disabled or full.
  const main = document.querySelector("[data-reading-title]");

  if (main instanceof HTMLElement) {
    saveContinueReading({
      title: main.dataset.readingTitle ?? "",
      description: main.dataset.readingDescription ?? "",
      category: main.dataset.readingCategory,
      url: window.location.pathname,
    });
  }

  /**
   * 🔗 Share Button
   */

  const shareButton =
    document.querySelector(
      "[data-teaching-share]"
    );

  if (
    shareButton
    instanceof HTMLButtonElement
  ) {

    const label =
      shareButton.querySelector(
        "[data-share-label]"
      );

    const originalLabel =
      label?.textContent || "Share";

    let resetTimer:
      number | undefined;

    const setLabel =
      (text: string) => {

        if (label)
          label.textContent = text;

        window.clearTimeout(
          resetTimer
        );

        resetTimer =
          window.setTimeout(() => {

            if (label)
              label.textContent =
                originalLabel;

          }, 1800);

      };

    shareButton
      .addEventListener(
        "click",
        async () => {

          const shareData = {

            title:
              document.title,

            url:
              window.location.href,

          };

          try {

            if (
              navigator.share
            ) {

              await navigator.share(
                shareData
              );

              return;

            }

            await navigator
              .clipboard
              .writeText(
                window.location.href
              );

            setLabel(
              "Copied"
            );

          } catch {

            setLabel(
              "Copy failed"
            );

          }

        }
      );

  }

</script>