<div class="mx-auto w-full max-w-[720px] px-4 sm:px-6 space-y-8">

  <!-- QUICK GUIDE -->
  <div class="p-5 rounded-2xl border border-[var(--color-border)] bg-[var(--color-primary)]/5 text-sm text-[var(--color-muted)]">
    <strong>Quick guide:</strong><br />
    Enter a website or URL, generate your QR code, then download it as PNG or SVG.
  </div>

  <!-- URL INPUT -->
  <div class="rounded-2xl border border-[var(--color-border)] p-5 space-y-4">

    <div>
      <label
        for="qr-url"
        class="block text-sm font-medium"
      >
        Website or URL
      </label>

      <p class="mt-1 text-xs text-[var(--color-muted)]">
        Enter the address you want the QR code to open.
      </p>
    </div>

    <input
      id="qr-url"
      type="url"
      value="https://first7.org"
      placeholder="https://example.com"
      autocomplete="url"
      class="w-full px-4 py-4 text-base rounded-xl border border-[var(--color-border)] bg-transparent"
    />

    <div class="space-y-2">
  <label
    for="error-correction"
    class="block text-sm font-medium"
  >
    Error Correction
  </label>

  <select
    id="error-correction"
    class="w-full px-4 py-3 text-base rounded-xl border border-[var(--color-border)] bg-transparent"
  >
    <option value="L">Low — 7%</option>
    <option value="M" selected>Medium — 15%</option>
    <option value="Q">Quartile — 25%</option>
    <option value="H">High — 30%</option>
  </select>

  <p class="text-xs text-[var(--color-muted)]">
    Higher correction makes the QR code more resistant to damage,
    but may make it slightly denser.
  </p>
</div>

    <p
      id="qr-error"
      class="hidden text-sm text-red-500"
      role="alert"
    ></p>

    <button
      id="generate-btn"
      type="button"
      class="btn w-full py-3 text-base rounded-xl"
    >
      Generate QR Code
    </button>

  </div>

  <!-- QR PREVIEW -->
<div class="rounded-2xl border border-[var(--color-border)] p-5 space-y-4">

  <div class="flex items-center justify-between gap-4">
    <p class="font-medium text-base">
      QR Code
    </p>

    <span
      class="text-xs px-2.5 py-1 rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)]"
    >
      Static
    </span>
  </div>

  <div
    id="qr-preview"
    class="min-h-[300px] rounded-2xl bg-white flex items-center justify-center p-8 shadow-sm"
  >
    <p class="text-sm text-gray-500">
      Your QR code will appear here.
    </p>
  </div>

  <div class="space-y-3">

    <div
      class="flex items-center gap-2 rounded-xl border border-[var(--color-border)] px-4 py-3"
    >
      <p
        id="qr-value"
        class="flex-1 min-w-0 text-xs text-[var(--color-muted)] break-all"
      ></p>

      <button
        id="copy-url"
        type="button"
        class="btn-secondary shrink-0 px-3 py-2 rounded-lg text-xs"
      >
        Copy
      </button>
    </div>

    <p class="text-xs text-[var(--color-muted)]">
      The QR code contains this URL directly.
    </p>

  </div>

</div>

  <!-- DOWNLOAD -->
  <div class="flex flex-col sm:flex-row gap-3">

    <button
      id="download-png"
      type="button"
      disabled
      class="btn flex-1 py-3 text-base rounded-xl disabled:opacity-50 disabled:cursor-not-allowed"
    >
      Download PNG
    </button>

    <button
      id="download-svg"
      type="button"
      disabled
      class="btn-secondary flex-1 py-3 text-base rounded-xl disabled:opacity-50 disabled:cursor-not-allowed"
    >
      Download SVG
    </button>

  </div>

  <!-- STATIC QR EXPLANATION -->
<div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-primary)]/5 p-5 space-y-2">

  <p class="font-medium text-[var(--color-text)]">
    Static QR Code
  </p>

  <p class="text-sm text-[var(--color-muted)] leading-relaxed">
    Your QR code contains the URL directly. It does not expire,
    require a subscription, or depend on a QR code service.
  </p>

</div>

  <!-- HOW TO USE -->
  <div class="rounded-2xl border border-[var(--color-border)] p-5 text-sm text-[var(--color-muted)] space-y-2">

    <p class="font-medium text-[var(--color-text)]">
      How to use
    </p>

    <p>1. Enter a website or URL.</p>
    <p>2. Click “Generate QR Code”.</p>
    <p>3. Download the QR code as PNG or SVG.</p>
    <p class="pt-2">
      QR codes are generated directly in your browser. Your URL is not sent to a QR code service.
    </p>

  </div>

</div>

<script>
  import QRCode from "qrcode";

  document.addEventListener("DOMContentLoaded", () => {
    const urlInput =
      document.getElementById("qr-url") as HTMLInputElement;

    const errorCorrection =
      document.getElementById("error-correction") as HTMLSelectElement;

    const generateBtn =
      document.getElementById("generate-btn") as HTMLButtonElement;

    const preview =
      document.getElementById("qr-preview") as HTMLElement;

    const valueEl =
      document.getElementById("qr-value") as HTMLElement;

    const errorEl =
      document.getElementById("qr-error") as HTMLElement;

    const downloadPng =
      document.getElementById("download-png") as HTMLButtonElement;

    const downloadSvg =
      document.getElementById("download-svg") as HTMLButtonElement;

    const copyUrl =
      document.getElementById("copy-url") as HTMLButtonElement;

    if (
      !urlInput ||
      !errorCorrection ||
      !generateBtn ||
      !preview ||
      !valueEl ||
      !errorEl ||
      !downloadPng ||
      !downloadSvg ||
      !copyUrl
    ) return;

    let currentUrl = "";

    function validateUrl(value: string): URL | null {
      try {
        const url = new URL(value);

        if (!["http:", "https:"].includes(url.protocol)) {
          return null;
        }

        return url;
      } catch {
        return null;
      }
    }

    function showError(message: string) {
      errorEl.textContent = message;
      errorEl.classList.remove("hidden");
    }

    function clearError() {
      errorEl.textContent = "";
      errorEl.classList.add("hidden");
    }

    function getFileName(url: string): string {
      try {
    const parsed = new URL(url);

    const host = parsed.hostname
        .replace(/^www\./, "")
        .replace(/[^a-z0-9]+/gi, "-")
        .replace(/^-+|-+$/g, "");

    const path = parsed.pathname
        .replace(/^\/+|\/+$/g, "")
        .replace(/[^a-z0-9]+/gi, "-")
        .replace(/^-+|-+$/g, "");

    const parts = [host, path].filter(Boolean);

        return `${parts.join("-") || "qr-code"}-qr`;
      } catch {
        return "qr-code";
      }
    }

    async function generateQRCode() {
      const value = urlInput.value.trim();

      clearError();

      const url = validateUrl(value);

      if (!url) {
        showError("Please enter a valid website URL.");
        return;
      }

      currentUrl = url.toString();

      generateBtn.disabled = true;
      generateBtn.textContent = "Generating...";

      try {
        const svg = await QRCode.toString(currentUrl, {
          type: "svg",
          errorCorrectionLevel:
            errorCorrection.value as "L" | "M" | "Q" | "H",
          margin: 2,
          width: 512,
          color: {
          dark: "#000000",
          light: "#ffffff",
          },
        });

        preview.innerHTML = svg;

        const svgElement =
          preview.querySelector("svg");

        if (svgElement) {
          svgElement.setAttribute(
            "class",
            "w-full max-w-[320px] h-auto"
          );
          svgElement.setAttribute(
            "aria-label",
            `QR code for ${currentUrl}`
          );
        }

        valueEl.textContent = currentUrl;

        downloadPng.disabled = false;
        downloadSvg.disabled = false;

      } catch (error) {
        console.error("QR generation failed:", error);
        showError("Unable to generate the QR code. Please try again.");
      } finally {
        generateBtn.disabled = false;
        generateBtn.textContent = "Generate QR Code";
      }
    }

    async function copyURL() {
  if (!currentUrl) return;

  try {
    await navigator.clipboard.writeText(currentUrl);

    copyUrl.textContent = "Copied";

    setTimeout(() => {
      copyUrl.textContent = "Copy";
    }, 1500);

  } catch (error) {
    console.error("Copy failed:", error);
    showError("Unable to copy the URL.");
  }
}

    async function downloadPNG() {
  if (!currentUrl) return;

  downloadPng.disabled = true;
  downloadPng.textContent = "Generating...";

  try {
    const dataUrl = await QRCode.toDataURL(currentUrl, {
      errorCorrectionLevel:
        errorCorrection.value as "L" | "M" | "Q" | "H",
      margin: 4,
      width: 1024,
      color: {
        dark: "#000000",
        light: "#ffffff",
      },
    });

    const link = document.createElement("a");

    link.href = dataUrl;
    link.download = `${getFileName(currentUrl)}.png`;
    link.click();

  } catch (error) {
    console.error("PNG generation failed:", error);
    showError("Unable to create the PNG file.");
  } finally {
    downloadPng.disabled = false;
    downloadPng.textContent = "Download PNG";
  }
}

    async function downloadSVG() {
  if (!currentUrl) return;

  downloadSvg.disabled = true;
  downloadSvg.textContent = "Generating...";

  try {
    const svg = await QRCode.toString(currentUrl, {
      type: "svg",
      errorCorrectionLevel:
        errorCorrection.value as "L" | "M" | "Q" | "H",
      margin: 4,
      width: 1024,
      color: {
        dark: "#000000",
        light: "#ffffff",
      },
    });

    const blob = new Blob(
      [svg],
      { type: "image/svg+xml;charset=utf-8" }
    );

    const url = URL.createObjectURL(blob);

    const link = document.createElement("a");

    link.href = url;
    link.download = `${getFileName(currentUrl)}.svg`;
    link.click();

    setTimeout(() => {
      URL.revokeObjectURL(url);
    }, 1000);

  } catch (error) {
    console.error("SVG generation failed:", error);
    showError("Unable to create the SVG file.");
  } finally {
    downloadSvg.disabled = false;
    downloadSvg.textContent = "Download SVG";
  }
}

    generateBtn.addEventListener(
      "click",
      generateQRCode
    );

    errorCorrection.addEventListener(
      "change",
      generateQRCode
    );

    downloadPng.addEventListener(
      "click",
      downloadPNG
    );

    downloadSvg.addEventListener(
      "click",
      downloadSVG
    );

    copyUrl.addEventListener(
      "click",
      copyURL
    );

    urlInput.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Enter") {
          generateQRCode();
        }
      }
    );

    generateQRCode();
  });
</script>