---
import type { CollectionEntry } from "astro:content";
import DictionaryBreadcrumb from "./DictionaryBreadcrumb.astro";

interface Props {
  entry: CollectionEntry<"dictionary">;

  collections: {
    dictionary: CollectionEntry<"dictionary">[];
    teachings: CollectionEntry<"teachings">[];
    prophecy: CollectionEntry<"prophecy">[];
    numbers: CollectionEntry<"numbers">[];
  };
}

const {
  entry,
  collections,
} = Astro.props;

const sortedDictionary = [...collections.dictionary].sort((a, b) =>
  a.data.term.localeCompare(b.data.term)
);

const currentIndex = sortedDictionary.findIndex(
  (item) => item.id === entry.id
);

const totalTerms = sortedDictionary.length;

const currentLetter =
  entry.data.term.charAt(0).toUpperCase();
---

<section
  class="
    mt-8
    rounded-2xl
    border
    border-[var(--color-border)]
    bg-[var(--color-surface)]
    p-6
  "
>

  <h2
    class="
      text-xl
      font-semibold
    "
  >
    Quick Reference
  </h2>

  <DictionaryBreadcrumb
    title={entry.data.title}
  />

  <div
    class="
      my-6
      h-px
      bg-[var(--color-border)]
    "
  />

  <!-- Statistics -->

  <div
    class="
      grid
      gap-4
      md:grid-cols-3
    "
  >

    <div
      class="
        rounded-xl
        border
        border-[var(--color-border)]
        p-4
        text-center
      "
    >

      <p
        class="
          text-xs
          uppercase
          tracking-wide
          text-[var(--color-muted)]
        "
      >
        Total Entries
      </p>

      <p
        class="
          mt-2
          text-2xl
          font-bold
        "
      >
        {totalTerms}
      </p>

    </div>

    <div
      class="
        rounded-xl
        border
        border-[var(--color-border)]
        p-4
        text-center
      "
    >

      <p
        class="
          text-xs
          font-semibold
          uppercase
          tracking-wide
          text-[var(--color-muted)]
        "
      >
        Entry Position
      </p>

      <p
        class="
          mt-2
          text-2xl
          font-bold
        "
      >
        {currentIndex + 1} of {totalTerms}
      </p>

    </div>

    <div
      class="
        rounded-xl
        border
        border-[var(--color-border)]
        p-4
        text-center
      "
    >

      <p
        class="
          text-xs
          uppercase
          tracking-wide
          text-[var(--color-muted)]
        "
      >
        Letter
      </p>

      <p
        class="
          mt-2
          text-2xl
          font-bold
        "
      >
        {currentLetter}
      </p>

    </div>

  </div>

  <!-- Main Reference Information -->

  <div
    class="
      mt-8
      grid
      gap-8
      lg:grid-cols-2
    "
  >

    <!-- Meaning -->

    <div>

      <h3
        class="
          text-sm
          font-semibold
          uppercase
          tracking-wide
          text-[var(--color-muted)]
        "
      >
        Meaning
      </h3>

      <p class="mt-2 leading-relaxed">
        {entry.data.shortMeaning}
      </p>

    </div>

    <!-- Scriptures -->

    {entry.data.scriptures?.length > 0 && (

      <div>

        <h3
          class="
            text-sm
            font-semibold
            uppercase
            tracking-wide
            text-[var(--color-muted)]
          "
        >
          Key Scriptures
        </h3>

        <ul
          class="
            mt-2
            space-y-1
          "
        >

          {entry.data.scriptures.map((scripture) => (

            <li>
              {scripture}
            </li>

          ))}

        </ul>

      </div>

    )}

    <!-- Aliases -->

    {entry.data.aliases?.length > 0 && (

      <div>

        <h3
          class="
            text-sm
            font-semibold
            uppercase
            tracking-wide
            text-[var(--color-muted)]
          "
        >
          Also Called
        </h3>

        <div
          class="
            mt-2
            flex
            flex-wrap
            gap-2
          "
        >

          {entry.data.aliases.map((alias) => (

            <span
              class="
                rounded-full
                border
                border-[var(--color-border)]
                px-3
                py-1
                text-sm
              "
            >
              {alias}
            </span>

          ))}

        </div>

      </div>

    )}

    <!-- Related -->

    {entry.data.related?.length > 0 && (

      <div>

        <h3
          class="
            text-sm
            font-semibold
            uppercase
            tracking-wide
            text-[var(--color-muted)]
          "
        >
          Related Terms
        </h3>

        <div
          class="
            mt-2
            flex
            flex-wrap
            gap-2
          "
        >

          {entry.data.related.map((item) => (

            <a
              href={`/dictionary/${item}`}
              class="
                rounded-full
                border
                border-[var(--color-border)]
                px-3
                py-1
                text-sm
                transition
                hover:border-[var(--color-primary)]
              "
            >
              {item}
            </a>

          ))}

        </div>

      </div>

    )}

  </div>

  <!-- Original Language -->

  {(entry.data.hebrew || entry.data.greek) && (

    <div
      class="
        mt-8
        border-t
        border-[var(--color-border)]
        pt-8
      "
    >

      <h3
        class="
          text-sm
          font-semibold
          uppercase
          tracking-wide
          text-[var(--color-muted)]
        "
      >
        Original Language
      </h3>

      <div
        class="
          mt-4
          grid
          gap-4
          md:grid-cols-2
        "
      >

        <!-- Hebrew -->

        {entry.data.hebrew && (

          <div
            class="
              rounded-xl
              border
              border-[var(--color-border)]
              p-5
            "
          >

            <p
              class="
                text-xs
                font-semibold
                uppercase
                tracking-wide
                text-[var(--color-muted)]
              "
            >
              Hebrew
            </p>

            <p
              class="
                mt-3
                text-2xl
                font-semibold
              "
              dir="rtl"
            >
              {entry.data.hebrew.word}
            </p>

            <p
              class="
                mt-2
                text-sm
                italic
                text-[var(--color-muted)]
              "
            >
              {entry.data.hebrew.transliteration}
            </p>

            {entry.data.hebrew.meaning && (

              <p
                class="
                  mt-2
                  leading-relaxed
                "
              >
                {entry.data.hebrew.meaning}
              </p>

            )}

          </div>

        )}

        <!-- Greek -->

        {entry.data.greek && (

          <div
            class="
              rounded-xl
              border
              border-[var(--color-border)]
              p-5
            "
          >

            <p
              class="
                text-xs
                font-semibold
                uppercase
                tracking-wide
                text-[var(--color-muted)]
              "
            >
              Greek
            </p>

            <p
              class="
                mt-3
                text-2xl
                font-semibold
              "
            >
              {entry.data.greek.word}
            </p>

            <p
              class="
                mt-2
                text-sm
                italic
                text-[var(--color-muted)]
              "
            >
              {entry.data.greek.transliteration}
            </p>

            {entry.data.greek.meaning && (

              <p
                class="
                  mt-2
                  leading-relaxed
                "
              >
                {entry.data.greek.meaning}
              </p>

            )}

          </div>

        )}

      </div>

    </div>

  )}

</section>