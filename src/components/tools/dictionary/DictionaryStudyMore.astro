
---
import type { CollectionEntry } from "astro:content";

interface ResolvedRelatedTerm {
  id: string;
  title: string;
  href: string;
}

interface Props {
  entry: CollectionEntry<"dictionary">;

  collections: {
    dictionary: CollectionEntry<"dictionary">[];
    teachings: CollectionEntry<"teachings">[];
    prophecy: CollectionEntry<"prophecy">[];
    numbers: CollectionEntry<"numbers">[];
  };

  resolvedRelatedTerms: ResolvedRelatedTerm[];
}

const { entry, resolvedRelatedTerms } = Astro.props;

const scriptures = entry.data.scriptures ?? [];
const tags = entry.data.tags ?? [];
---

<section
  class="
    mt-16
    rounded-2xl
    border
    border-[var(--color-border)]
    bg-[var(--color-surface)]
    p-6
  "
>
  <h2
    class="
      text-2xl
      font-bold
    "
  >
    Study More
  </h2>

  <p
    class="
      mt-2
      text-[var(--color-muted)]
    "
  >
    Continue your Bible study by exploring
    related Scriptures, dictionary terms,
    and connected topics.
  </p>

  <div
    class="
      mt-8
      grid
      gap-8
      md:grid-cols-3
    "
  >
    <!-- Scriptures -->

    <section>
      <h3
        class="
          mb-3
          text-lg
          font-semibold
        "
      >
        Scriptures
      </h3>

      <ul class="space-y-2">
        {scriptures.map((scripture) => (
          <li>
            {scripture}
          </li>
        ))}
      </ul>
    </section>

    <!-- Related Terms -->

    <section>
      <h3
        class="
          mb-3
          text-lg
          font-semibold
        "
      >
        Related Terms
      </h3>

      {resolvedRelatedTerms.length > 0 ? (
        <div
          class="
            flex
            flex-wrap
            gap-2
          "
        >
          {resolvedRelatedTerms.map((item) => (
            <a
              href={item.href}
              class="
                rounded-full
                border
                border-[var(--color-border)]
                px-3
                py-1
                text-sm
                transition
                hover:border-[var(--color-primary)]
              "
            >
              {item.title}
            </a>
          ))}
        </div>
      ) : (
        <p class="text-sm text-[var(--color-muted)]">
          No linked dictionary terms are available.
        </p>
      )}
    </section>

    <!-- Study Topics -->

    <section>
      <h3
        class="
          mb-3
          text-lg
          font-semibold
        "
      >
        Study Topics
      </h3>

      <div
        class="
          flex
          flex-wrap
          gap-2
        "
      >
        {tags.map((tag) => (
          <span
            class="
              rounded-full
              border
              border-[var(--color-border)]
              px-3
              py-1
              text-sm
            "
          >
            {tag}
          </span>
        ))}
      </div>
    </section>
  </div>
</section>
