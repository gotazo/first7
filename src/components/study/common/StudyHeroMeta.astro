---
interface Props {
  label: string;
  items: string[];
  href?: string;
  linkLabel?: string;
  itemLabels?: Record<string, string>;
}

const {
  label,
  items,
  href,
  linkLabel,
  itemLabels,
} = Astro.props;

/**
 * Resolve display labels when a label map is provided.
 *
 * The stored value remains the canonical ID.
 * Only the displayed text is changed.
 *
 * Example:
 * "holy-spirit" → "Holy Spirit"
 * "spiritual-growth" → "Spiritual Growth"
 *
 * If no matching label exists, the original item
 * is displayed unchanged.
 */
const displayItems = items.map((item) => ({
  id: item,
  label: itemLabels?.[item] ?? item,
}));
---

{
  displayItems.length > 0 && (

    <div class="space-y-3">

      <p
        class="
          text-xs
          font-semibold
          uppercase
          tracking-[0.2em]
          text-[var(--color-muted)]
        "
      >
        {label}
      </p>

      <div
        class="
          flex
          flex-wrap
          gap-2
        "
      >

        {displayItems.map(({ label: itemLabel }) => (

          <span
            class="
              rounded-full
              border
              border-[var(--color-border)]
              bg-[var(--color-bg-soft)]
              px-3
              py-1
              text-sm
            "
          >
            {itemLabel}
          </span>

        ))}

      </div>

      {
        href &&
        linkLabel && (

          <a
            href={href}
            class="
              inline-flex
              text-sm
              font-medium
              text-[var(--color-primary)]
              hover:underline
            "
          >
            {linkLabel} →
          </a>

        )
      }

    </div>

  )
}