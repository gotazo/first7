---
import { normalizeBibleReference } from "../../lib/bible/normalizeBibleReference";

interface Props {
  scriptures: string[];
}

const { scriptures } = Astro.props;
---

<section class="space-y-5">
  <h2 class="text-2xl font-semibold">
    Related Scriptures
  </h2>

  <div class="flex flex-wrap gap-3">
    {scriptures.map((scripture) => {
      const normalized = normalizeBibleReference(scripture);

      if (!normalized) return null;

      return (
        <a
          href={normalized.path}
          class="rounded-full border border-[var(--color-border)] px-4 py-2 text-sm transition hover:border-[var(--color-primary)] hover:bg-[var(--color-primary)]/5"
        >
          {scripture}
        </a>
      );
    })}
  </div>
</section>